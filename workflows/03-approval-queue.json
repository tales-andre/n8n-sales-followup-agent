    {
      "id": "5bdcfe45-b32f-5a84-a510-c4943bd5a656",
      "name": "Build the approval page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const s = $('Settings').first().json;\nconst css = \".wrap{max-width:860px;margin:24px auto;font-family:Segoe UI,Arial,sans-serif;color:#1d2a22;padding:0 16px}h1{font-size:24px;margin:0 0 4px}.sub{color:#5b6b61;margin:0 0 20px}.card{border:1px solid #d5ddd8;border-radius:10px;padding:16px;margin:0 0 16px;background:#fff}.meta{font-size:13px;color:#5b6b61;margin-bottom:8px}.tag{display:inline-block;font-size:12px;padding:2px 8px;border-radius:10px;background:#e8f1ec;color:#1f6f43;margin-right:6px}.tag.p{background:#eef0fb;color:#3a46a0}label{font-size:13px;font-weight:600;display:block;margin:8px 0 4px}input[type=text],textarea{width:100%;box-sizing:border-box;font:inherit;font-size:14px;padding:8px;border:1px solid #c4cec8;border-radius:6px}textarea{min-height:270px}.warn{background:#fff4e0;color:#7a4b00;border-radius:6px;padding:8px 10px;font-size:13px;margin:6px 0}.btns{margin-top:10px;display:flex;gap:8px}button{font:inherit;font-size:14px;padding:8px 16px;border-radius:6px;border:0;cursor:pointer}.ok{background:#1f6f43;color:#fff}.no{background:#f3e4e4;color:#8a1f1f}.empty{padding:24px;border:1px dashed #c4cec8;border-radius:10px;color:#5b6b61}.msg{padding:16px;border-radius:10px;margin:0 0 16px}.msg.good{background:#e8f1ec}.msg.bad{background:#fbeaea}body{background:#f6f8f7;margin:0}\";\nconst esc = v => String(v ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst validEmail = e => /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(e || ''));\n// drafts with a valid address first; a bad address is flagged (it will be refused at send time)\nconst rows = $input.all().map(i => i.json).filter(r => r.id)\n  .sort((a, b) => Number(validEmail(b.email)) - Number(validEmail(a.email)));\nconst action = s.baseUrl + '/webhook/decision';\nconst cards = rows.map(r => `\n<div class=\"card\">\n  <div class=\"meta\"><span class=\"tag ${r.kind === 'intro' ? 'p' : ''}\">${r.kind === 'intro' ? 'New prospect' : 'Win back'}</span>\n    To <b>${esc(r.contact_name)}</b> &lt;${esc(r.email)}&gt; at <b>${esc(r.company)}</b> &middot; rep: ${esc(r.sales_rep)} &middot; drafted by: ${esc(r.drafted_by)}</div>\n  ${validEmail(r.email) ? '' : '<div class=\"warn\">This email address looks wrong. If you approve, it will NOT be sent: it is marked as failed and an alert is emailed. Fix the address in the customer list first.</div>'}\n  <form method=\"post\" action=\"${esc(action)}\">\n    <input type=\"hidden\" name=\"id\" value=\"${r.id}\">\n    <input type=\"hidden\" name=\"token\" value=\"${esc(r.approval_token)}\">\n    <label>Subject</label><input type=\"text\" name=\"subject\" value=\"${esc(r.subject)}\">\n    <label>Message</label><textarea name=\"body\">${esc(r.body)}</textarea>\n    <div class=\"btns\"><button class=\"ok\" name=\"decision\" value=\"approve\">Approve &amp; send</button>\n    <button class=\"no\" name=\"decision\" value=\"reject\">Reject</button></div>\n  </form>\n</div>`).join('');\nconst body = rows.length ? cards : '<div class=\"empty\">Nothing is waiting for approval. New drafts appear here after the daily run.</div>';\nconst html = `<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Follow-ups waiting for approval</title><style>${css}</style></head><body><div class=\"wrap\">\n<h1>Follow-ups waiting for approval</h1>\n<p class=\"sub\">${esc(s.companyName)} &middot; ${rows.length} draft(s). Nothing is sent until you press <b>Approve &amp; send</b>. You can edit the text first.</p>\n${body}</div></body></html>`;\nreturn [{ json: { html } }];\n"
      }
    },
