# Copy to .env only if you want to change something. Without a .env file the demo
# runs with safe local defaults: sample database, fake mailbox, offline template.

# --- n8n -------------------------------------------------------------------
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
PUBLIC_URL=http://localhost:5678/          # used in the links of the approval emails
TIMEZONE=America/New_York

# --- Customer / order database (Postgres or Supabase) ------------------------
# Supabase: DB_HOST=db.<project-ref>.supabase.co  DB_USER=postgres  DB_SSL=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sales
DB_USER=sales
DB_PASSWORD=replace-me

# --- Rules ----------------------------------------------------------------
INACTIVE_DAYS=60            # a customer with no order for this many days gets a "win back" draft
PROSPECTS_PER_DAY=3         # first-touch drafts for new prospects, per day
COMPANY_NAME=Cedar Ridge Supply Co.
SALES_FROM_EMAIL=sales@your-company.example
SALES_MANAGER_EMAIL=manager@your-company.example   # gets the "drafts waiting" summary
ALERT_EMAIL=alerts@your-company.example            # gets an email when something fails

# --- Sending -----------------------------------------------------------------
# smtp    = the SMTP server below (demo: Mailpit, a fake inbox at http://localhost:8025)
# outlook = Microsoft Outlook node (connect the Microsoft credential in n8n first, see README)
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- AI writer ---------------------------------------------------------------
# stub      = offline template, no AI, no key (default; used for the screenshots and tests)
# openai    = any OpenAI-compatible chat endpoint (set LLM_MODEL; LLM_BASE_URL to change the host)
# anthropic = Claude Messages API (LLM_MODEL defaults to claude-opus-5)
# ollama    = local model (LLM_BASE_URL defaults to http://host.docker.internal:11434)
LLM_PROVIDER=stub
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
